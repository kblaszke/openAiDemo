{{> header}}
<div class="center">
<h1>AI Client</h1>

<form action="/" method="post">
    <input type="hidden" name="conversationId" value="{{conversationId}}"/>
    <div>
        <input id="user_role" type="radio" name="role" value="USER" checked/>
        <label for="user_role">question</label>
        <input id="assistant_role" type="radio" name="role" value="ASSISTANT"/>
        <label for="assistant_role">setting</label>
    </div>
    <div>
        <textarea type="text" name="prompt" cols="80" rows="8"></textarea>
    </div>
  <input type="submit">
</form>
<div class="center">
    {{answer}}
</div>
</div>

{{> footer}}